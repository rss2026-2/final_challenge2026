<launch>

    <node pkg="safety_controller" name="controller" exec="controller" output="screen">
        <param from="$(find-pkg-share final_challenge2026)/config/partb_config.yaml"/>
    </node>

    <node pkg="final_challenge2026" name="homography_transformer_b" exec="homography_transformer_b" output="screen">
        <param from="$(find-pkg-share final_challenge2026)/config/partb_config.yaml"/>
    </node>

    <node pkg="localization" exec="particle_filter" name="particle_filter" output="screen">
        <param from="$(find-pkg-share final_challenge2026)/config/localization_config.yaml"/>
    </node>

    <node pkg="final_challenge2026" name="path_planner_node" exec="path_planner" output="screen">
        <param from="$(find-pkg-share final_challenge2026)/config/partb_config.yaml"/>
    </node>

    <node pkg="final_challenge2026" name="trajectory_follower_node" exec="trajectory_follower" output="screen">
        <param from="$(find-pkg-share final_challenge2026)/config/partb_config.yaml"/>
    </node>

    <node pkg="final_challenge2026" name="yolo_detection_node" exec="yolo_detection" output="screen">
    </node>

    <node pkg="final_challenge2026" name="traffic_light_node" exec="traffic_light" output="screen">
        <param from="$(find-pkg-share final_challenge2026)/config/partb_config.yaml"/>
    </node>

    <node pkg="final_challenge2026" name="parking_meter_node" exec="parking_meter" output="screen">
        <param from="$(find-pkg-share final_challenge2026)/config/partb_config.yaml"/>
    </node>

    <node pkg="final_challenge2026" name="parking_controller" exec="parking_controller" output="screen">
        <param name="drive_topic" value="/vesc/high_level/input/nav_1" />
        <param name="detection_mode" value="line" />
    </node>

</launch>
