    </node>

    <node pkg="final_challenge2026" name="yolo_detection_node" exec="yolo_detection" output="screen">
    </node>

    <!-- <node pkg="final_challenge2026" name="traffic_light_node" exec="traffic_light" output="screen">
    </node> -->

    <node pkg="final_challenge2026" name="parking_meter_node" exec="parking_meter" output="screen">
